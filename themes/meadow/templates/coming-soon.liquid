<!doctype html>
<html lang="{{ site.locale }}" data-fonts="{{ design.fonts }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {% render "head-fonts" %}
  {% seo %}
</head>
<body>
  <main class="t-coming-soon">
    <div class="t-wrap">
      {% if site.logo %}<p class="t-coming-soon-logo">{% image site.logo, size: "logo", alt: site.name %}</p>{% endif %}
      <h1>{{ site.name }}</h1>
      {% if site.tagline != blank %}<p class="t-lead">{{ site.tagline }}</p>{% endif %}
      <p>{{ "coming_soon" | t }}</p>
      {% if site.business.has_any %}{% render "business", business: site.business, level: 2 %}{% endif %}
    </div>
  </main>
</body>
</html>
