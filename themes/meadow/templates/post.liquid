{% layout "layout" %}
{% block content %}
<article class="t-article t-post">
  <div class="t-page-head">
    <p class="t-meta"><time datetime="{{ post.published_at | iso_date }}">{{ post.published_at | date: "long" }}</time></p>
    <h1>{{ post.title }}</h1>
  </div>
  {%- comment %}Its picture, unless the post's own words show it.{% endcomment %}
  {% if post.image %}{% unless post.html contains post.image.id %}<div class="t-wrap t-cover">{% image post.image, size: "cover", priority: true %}</div>{% endunless %}{% endif %}
  <div class="t-body">{{ post.html | raw }}</div>
  <div class="t-wrap t-post-foot">
    {% if post.tags.size > 0 %}
    <ul class="t-tags" aria-label="{{ 'tags' | t }}">
      {% for tag in post.tags %}<li><a href="{{ tag.url }}">{{ tag.name }}</a></li>{% endfor %}
    </ul>
    {% endif %}
    <p><a class="t-button t-button-quiet" href="/blog">{{ "more_posts" | t }}</a></p>
  </div>
</article>
{% endblock %}
