{% layout "layout" %}
{% block title %}{{ page.title }} · {{ site.name }}{% endblock %}
{% block description %}{% if page.summary != blank %}<meta name="description" content="{{ page.summary }}">{% endif %}{% endblock %}
{% block content %}
<article class="t-wrap t-article">
  <h1>{{ page.title }}</h1>
  <div class="t-body">{{ page.html | raw }}</div>
</article>
{% endblock %}
