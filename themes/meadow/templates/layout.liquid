<!doctype html>
<html lang="{{ site.locale }}" data-fonts="{{ design.fonts }}" data-header="{{ design.header }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {% render "head-fonts" %}
  {% seo %}
</head>
<body>
  <a class="t-skip" href="#content">{{ "skip" | t }}</a>
  {% render "header" %}
  <main id="content" class="t-main">
    {% block content %}{% endblock %}
  </main>
  {% render "footer" %}
  {% body_end %}
</body>
</html>
