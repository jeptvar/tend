{% layout "layout" %}
{% if page %}
{% block content %}
<article class="t-wrap t-article">
  <h1>{{ page.title }}</h1>
  {% if site.tagline != blank %}<p class="t-lead">{{ site.tagline }}</p>{% endif %}
  <div class="t-body">{% render "page-text", html: page.html, business: site.business %}</div>
</article>
{% endblock %}
{% else %}
{% block content %}
<div class="t-wrap">
  <h1>{{ site.name }}</h1>
  {% if site.tagline != blank %}<p class="t-lead">{{ site.tagline }}</p>{% endif %}
  {% for post in posts %}{% render "post-card", post: post %}{% else %}<p>{{ "no_posts" | t }}</p>{% endfor %}
  {% render "pagination", pagination: pagination %}
</div>
{% endblock %}
{% endif %}
