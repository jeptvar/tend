{% layout "layout" %}
{% if page %}
{% block description %}{% if page.summary != blank %}<meta name="description" content="{{ page.summary }}">{% endif %}{% endblock %}
{% block content %}
<article class="t-wrap t-article">
  <h1>{{ page.title }}</h1>
  {% if site.tagline != blank %}<p class="t-lead">{{ site.tagline }}</p>{% endif %}
  <div class="t-body">{{ page.html | raw }}</div>
</article>
{% endblock %}
{% else %}
{% block content %}
<div class="t-wrap">
  <h1>{{ site.name }}</h1>
  {% if site.tagline != blank %}<p class="t-lead">{{ site.tagline }}</p>{% endif %}
  {% for post in posts %}{% render "post-card", post: post %}{% else %}<p>There are no posts yet.</p>{% endfor %}
  {% render "pagination", pagination: pagination %}
</div>
{% endblock %}
{% endif %}
