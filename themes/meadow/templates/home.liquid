{% layout "layout" %}
{% if page %}
{% block content %}
{%- comment -%}
  A homepage that opens with a Big intro has that as its opening, so its title, which the
  header shows, is only said. The business details come straight after the intro.
{%- endcomment -%}
{%- assign opening = page.html | slice: 0, 24 -%}
<article class="t-home">
  {% if opening contains '<section class="t-intro' %}
  <h1 class="t-hidden">{{ page.title }}</h1>
  {%- assign parts = page.html | split: "</section>" -%}
  {%- assign ending = page.html | slice: -10, 10 -%}
  {%- capture rest -%}
    {%- for part in parts offset: 1 -%}
      {{- part | raw -}}
      {%- unless forloop.last -%}</section>{%- endunless -%}
    {%- endfor -%}
    {%- if parts.size > 1 and ending == "</section>" -%}</section>{%- endif -%}
  {%- endcapture -%}
  <div class="t-body">
    {{ parts[0] | raw }}</section>
    {% render "glance", business: site.business %}
    {% render "page-text", html: rest, business: site.business %}
  </div>
  {% else %}
  <div class="t-page-head">
    <h1>{{ page.title }}</h1>
    {% if site.tagline != blank %}<p class="t-lead">{{ site.tagline }}</p>{% endif %}
  </div>
  <div class="t-body">{% render "page-text", html: page.html, business: site.business %}</div>
  {% endif %}
</article>
{% endblock %}
{% else %}
{% block content %}
<div class="t-page-head">
  <h1>{{ site.name }}</h1>
  {% if site.tagline != blank %}<p class="t-lead">{{ site.tagline }}</p>{% endif %}
</div>
{% render "posts", posts: posts, pagination: pagination, none: "no_posts" %}
{% endblock %}
{% endif %}
