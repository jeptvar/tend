{%- comment -%}
  The fonts a site can choose in Design, as CSS: on every page, and in the admin, so what's
  written there looks as it will here. Each file has a few alphabets' letters, and is only
  fetched by a page that has some of them. Until it's there, a font the device has takes its
  place, stretched to take up the same room, so nothing moves when it arrives.
{%- endcomment -%}
{%- case design.fonts -%}
{%- when "classic" -%}
@font-face {
  font-family: Fraunces;
  font-weight: 100 900;
  font-display: swap;
  src: url("{{ "fonts/fraunces-vietnamese.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;
}
@font-face {
  font-family: Fraunces;
  font-weight: 100 900;
  font-display: swap;
  src: url("{{ "fonts/fraunces-latin-ext.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
}
@font-face {
  font-family: Fraunces;
  font-weight: 100 900;
  font-display: swap;
  src: url("{{ "fonts/fraunces-latin.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
  font-family: "Fraunces until it's here";
  size-adjust: 102%;
  ascent-override: 96%;
  descent-override: 24.5%;
  line-gap-override: 0%;
  src: local("Georgia");
}
@font-face {
  font-family: "Fraunces until it's here, large";
  size-adjust: 92%;
  ascent-override: 106%;
  descent-override: 27%;
  line-gap-override: 0%;
  src: local("Georgia");
}
:root {
  --tend-font-heading: Fraunces, "Fraunces until it's here", Georgia, serif;
  --tend-font-display: Fraunces, "Fraunces until it's here, large", Georgia, serif;
}
{%- when "friendly" -%}
@font-face {
  font-family: Nunito;
  font-weight: 200 1000;
  font-display: swap;
  src: url("{{ "fonts/nunito-cyrillic-ext.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F;
}
@font-face {
  font-family: Nunito;
  font-weight: 200 1000;
  font-display: swap;
  src: url("{{ "fonts/nunito-cyrillic.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;
}
@font-face {
  font-family: Nunito;
  font-weight: 200 1000;
  font-display: swap;
  src: url("{{ "fonts/nunito-vietnamese.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;
}
@font-face {
  font-family: Nunito;
  font-weight: 200 1000;
  font-display: swap;
  src: url("{{ "fonts/nunito-latin-ext.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
}
@font-face {
  font-family: Nunito;
  font-weight: 200 1000;
  font-display: swap;
  src: url("{{ "fonts/nunito-latin.woff2" | asset_url }}") format("woff2");
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
  font-family: "Nunito until it's here";
  size-adjust: 100.4%;
  ascent-override: 100.7%;
  descent-override: 35.2%;
  line-gap-override: 0%;
  src: local("Arial");
}
:root {
  --tend-font-body: Nunito, "Nunito until it's here", system-ui, sans-serif;
}
{%- endcase -%}
