<footer class="t-footer">
  <div class="t-wrap t-footer-inner">
    {% if site.business.has_any %}
    <div class="t-footer-business">
      <p class="t-footer-name">{{ site.name }}</p>
      {% if site.business.address_lines.size > 0 %}<p>{% for line in site.business.address_lines %}{{ line }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</p>{% endif %}
      {% if site.business.phone %}<p><a href="{{ site.business.phone_href }}">{{ site.business.phone }}</a></p>{% endif %}
      {% if site.business.email %}<p><a href="{{ site.business.email_href }}">{{ site.business.email }}</a></p>{% endif %}
    </div>
    {% endif %}
    {% if menus.footer.size > 0 %}
    <nav aria-label="Footer">
      <ul class="t-footer-menu">
        {% for item in menus.footer %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% for child in item.children %}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{% endfor %}{% endfor %}
      </ul>
    </nav>
    {% endif %}
    {% if site.social.size > 0 %}
    <ul class="t-social" aria-label="Elsewhere">
      {% for link in site.social %}<li><a href="{{ link.url }}" rel="me noopener">{{ link.name }}</a></li>{% endfor %}
    </ul>
    {% endif %}
    <p class="t-footer-text">{% if site.footer_text %}{{ site.footer_text }}{% else %}© {{ site.name }}{% endif %}</p>
  </div>
</footer>
