{% if pagination.page_count > 1 %}
<nav class="t-pagination" aria-label="{{ 'more_posts' | t }}">
  {% if pagination.newer_url %}<a href="{{ pagination.newer_url }}">{{ "newer" | t }}</a>{% endif %}
  {% if pagination.older_url %}<a href="{{ pagination.older_url }}">{{ "older" | t }}</a>{% endif %}
</nav>
{% endif %}
