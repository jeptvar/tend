<header class="t-header">
  <div class="t-wrap t-header-inner">
    <a class="t-brand" href="/"{% if request.path == "/" %} aria-current="page"{% endif %}>
      {%- if site.logo -%}
        {% image site.logo, size: "logo", alt: site.name %}
      {%- else -%}
        {{ site.name }}
      {%- endif -%}
    </a>
    {% if menus.main.size > 0 %}
    <nav aria-label="Main">
      <ul class="t-menu">
        {% for item in menus.main %}
        <li>
          {% if item.children.size > 0 %}
          {%- comment %}A menu that opens without any script: the link itself comes first inside.{% endcomment -%}
          <details class="t-dropdown">
            <summary>{{ item.title }}</summary>
            {%- comment %}The frame keeps the list on screen in browsers without anchor positioning.{% endcomment %}
            <div class="t-submenu-frame">
              <ul class="t-submenu">
                <li><a href="{{ item.url }}"{% if item.url == request.path %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
                {% for child in item.children %}
                <li><a href="{{ child.url }}"{% if child.url == request.path %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </details>
          {% else %}
          <a href="{{ item.url }}"{% if item.url == request.path %} aria-current="page"{% endif %}>{{ item.title }}</a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>
    {% endif %}
  </div>
</header>
