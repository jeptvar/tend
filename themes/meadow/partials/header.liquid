<header class="t-header">
  <div class="t-wrap t-header-inner">
    <a class="t-brand" href="/"{% if request.path == "/" %} aria-current="page"{% endif %}>
      {%- if site.logo -%}
        {% image site.logo, size: "logo", alt: site.name %}
      {%- else -%}
        {{ site.name }}
      {%- endif -%}
    </a>
    {% menu "main" %}
  </div>
</header>
