<header class="t-header">
  <div class="t-wrap t-header-inner">
    <a class="t-brand" href="/"{% if request.path == "/" %} aria-current="page"{% endif %}>
      {%- if site.logo -%}
        {% image site.logo, size: "logo", alt: site.name %}
      {%- else -%}
        {{ site.name }}
      {%- endif -%}
    </a>
    {% menu "main" %}
    {% if site.business.phone %}<a class="t-button t-button-quiet t-header-call" href="{{ site.business.phone_href }}">{% render "icon", name: "phone" %}<span>{{ site.business.phone }}</span></a>{% endif %}
  </div>
</header>
