{
  "name": "tendcms",
  "version": "0.0.0",
  "description": "Tend CMS: an easy, fast, self-hosted CMS",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tendcms/tend.git",
    "directory": "packages/tendcms"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tendcms": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "migrations",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "dev": "node --watch src/cli.ts start",
    "build": "tsdown"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "13.0.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.6",
    "@tendcms/admin": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "file-type": "22.2.0",
    "hono": "4.13.17",
    "intl-messageformat": "12.1.3",
    "liquidjs": "10.30.0",
    "zod": "4.6.7"
  }
}
