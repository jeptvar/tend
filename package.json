{
  "name": "tend-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke-dist.mjs",
    "typecheck": "tsc -b",
    "lint": "biome check . && node scripts/lint-migrations.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
