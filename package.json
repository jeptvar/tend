{
  "name": "tend-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke-dist.mjs",
    "smoke:create": "node scripts/smoke-create.mjs",
    "shrinkwrap": "node scripts/shrinkwrap.mjs",
    "size": "size-limit",
    "typecheck": "tsc -b",
    "lint": "biome check . && node scripts/lint-migrations.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "lighthouse": "playwright test --config=playwright.lighthouse.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "^24.19.2",
    "size-limit": "14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
